#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  printf 'uso: graphify-local <proyecto-local> [--force]\n' >&2
  exit 2
fi

project="$1"
force="${2:-}"
case "$project" in
  *://*|http:*|https:*|ftp:*)
    printf 'solo se admiten directorios locales\n' >&2
    exit 2
    ;;
esac

case "$force" in
  ''|--force)
    ;;
  *)
    printf 'opción no permitida: %s\n' "$force" >&2
    exit 2
    ;;
esac

exec node "$AISTACK_HOME/scripts/graphify-safe-sync.js" "$project" "$force"
